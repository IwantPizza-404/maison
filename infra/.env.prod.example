# Скопировать в infra/.env.prod и заполнить. Файл .env.prod не коммитится.
# Секреты генерировать так: openssl rand -hex 32   (только hex — без спецсимволов в URL)

DOMAIN=maison.uz

# Caddyfile — продакшен, Caddyfile.staging — тестовый сервер под паролем
CADDYFILE=Caddyfile
# Для тестового сервера: логин и хэш пароля (docker run --rm caddy:2.10-alpine caddy hash-password)
STAGING_USER=
STAGING_PASSWORD_HASH=

# true — разрешить индексацию поисковиками (только продакшен)
NUXT_INDEXABLE=false

POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
DJANGO_SECRET_KEY=

# Telegram-бот Maison (@BotFather): вход покупателей, уведомления покупателям и менеджеру
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MANAGER_CHAT_ID=
# Секрет вебхука бота: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Вход по SMS через Eskiz.uz (необязательно; пусто — только вход через Telegram)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# Вход по коду в WhatsApp (необязательно; WhatsApp Cloud API от Meta — см. docs/DEPLOY.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=login_code
WHATSAPP_TEMPLATE_LANGUAGE=ru

# Мониторинг ошибок (sentry.io), необязательно
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Фото в Cloudflare R2 / S3 (необязательно; пусто — фото на диске сервера)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Почта (необязательно)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
